<?xml version="1.0" encoding="utf-8"?>
<!-- bubble_root is NOT clickable: the outer BubbleView owns the click-to-expand listener
     (set in FloatingOverlayView). If this inner view consumed the tap, the expand listener
     would never fire. Visual only = 20dp (per user feedback: ~1/3 of the original 56dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:background="@drawable/overlay_bubble_bg">
    <!-- Ghost icon (new cute webtoon mascot from launcher) -->
    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
    <!-- Count badge, top-end (kept small) -->
    <TextView
        android:id="@+id/bubble_count"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-3dp"
        android:layout_marginEnd="-3dp"
        android:background="@drawable/overlay_status_pill_running"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:gravity="center"
        android:minWidth="12dp"
        android:text="0"
        android:textColor="@color/overlay_accent"
        android:textSize="7sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:includeFontPadding="false" />
</FrameLayout>
